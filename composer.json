{
    "name": "finansfatura/woocommerce-plugin",
    "description": "WooCommerce eklentisi — siparişi önce satışa çevirir, ardından Finansfatura üzerinden e-Arşiv / e-Fatura keser.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "finansfatura/finansfatura": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "Finansfatura\\Woo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
